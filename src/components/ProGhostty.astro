---
import { siteConfig } from "../config";
import ghostIcon from "../icon/proghostty@120.png";
const pg = siteConfig.proGhostty;
const accent = siteConfig.accentColor;
---

<section id="proghostty" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div
    class="relative overflow-hidden rounded-3xl border border-gray-200 bg-white p-8 sm:p-12 md:p-16"
  >
    <!-- corner glow -->
    <div
      class="absolute -top-40 -right-40 -z-10 size-96 rounded-full"
      style={`background: radial-gradient(circle, ${accent}26 0%, transparent 70%)`}
    ></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-4">
          <img
            src={ghostIcon.src}
            alt="ProGhostty"
            class="h-16 w-16 sm:h-20 sm:w-20 object-contain"
          />
          <span class="font-mono text-xs sm:text-sm tracking-widest" style={{ color: accent }}>
            FEATURED
          </span>
        </div>

        <h2 class="mt-6 text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">ProGhostty</h2>
        <p class="mt-3 text-lg sm:text-xl font-medium" style={{ color: accent }}>{pg.tagline}</p>
        <p class="mt-6 text-base sm:text-lg text-gray-600 leading-relaxed">{pg.summary}</p>

        <div class="mt-8 flex flex-wrap gap-2">
          {pg.skills.map((s) => (
            <span class="px-3 py-1 bg-gray-900 text-white rounded-full text-xs sm:text-sm font-medium">
              {s}
            </span>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={pg.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-white rounded-lg font-semibold transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
            style={{ backgroundColor: accent }}
          >
            GitHub 仓库 ↗
          </a>
          <a
            href={pg.site}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-gray-300 font-semibold text-gray-700 transition-all duration-300 hover:-translate-y-0.5 hover:bg-gray-50"
          >
            官网 ghostty.praw.top
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        {pg.bullets.map((b, i) => (
          <div class="flex gap-4">
            <span class="font-mono text-sm font-bold pt-1 flex-shrink-0" style={{ color: accent }}>
              0{i + 1}
            </span>
            <p class="text-sm sm:text-base text-gray-700 leading-relaxed">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

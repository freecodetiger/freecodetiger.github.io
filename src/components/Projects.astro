---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const accent = siteConfig.accentColor;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              项目
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${accent}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {siteConfig.projects.map((p, index) => {
                const isDark = index % 2 === 1;
                const isAccent = index === 2;
                const card = isDark
                  ? "bg-gray-900 border border-gray-800"
                  : isAccent
                    ? "bg-white border border-l-4 border-gray-200"
                    : "bg-white border border-gray-200";
                const title = isDark ? "text-white" : "text-gray-900";
                const desc = isDark ? "text-gray-300" : "text-gray-600";
                const num = isDark ? "text-gray-500" : "text-gray-400";
                const chip = isDark
                  ? "bg-gray-800 text-gray-200"
                  : "bg-gray-100 text-gray-800";
                const arrow = isDark
                  ? "bg-gray-700 group-hover:bg-gray-600"
                  : "bg-gray-900 group-hover:bg-gray-700";

                return (
                  <a
                    href={p.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`group relative block rounded-2xl p-6 sm:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${card}`}
                    style={isAccent ? `border-left-color: ${accent};` : undefined}
                  >
                    <div class="flex items-start justify-between gap-4">
                      <span class={`font-mono text-sm font-bold ${num}`}>0{index + 1}</span>
                      <span
                        class={`size-10 sm:size-11 flex items-center justify-center rounded-full text-white transition-all duration-300 ${arrow}`}
                      >
                        <svg
                          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M7 17L17 7M17 7H7M17 7V17"
                          />
                        </svg>
                      </span>
                    </div>

                    <h3 class={`mt-4 text-xl sm:text-2xl font-bold ${title}`}>{p.name}</h3>
                    <p class={`mt-3 text-sm sm:text-base leading-relaxed ${desc}`}>
                      {p.description}
                    </p>

                    {p.bullets && (
                      <ul class={`mt-5 space-y-2.5 text-sm sm:text-base leading-relaxed ${desc}`}>
                        {p.bullets.map((b) => (
                          <li class="flex items-start gap-2.5">
                            <span
                              class="mt-2 inline-block size-1.5 rounded-full flex-shrink-0"
                              style={{ backgroundColor: accent }}
                            />
                            <span>{b}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {p.skills && p.skills.length > 0 && (
                      <div class="mt-6 flex flex-wrap gap-2">
                        {p.skills.map((s) => (
                          <span class={`px-3 py-1 rounded-md text-xs sm:text-sm font-medium ${chip}`}>
                            {s}
                          </span>
                        ))}
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

---
import { siteConfig } from "../config";
import whisperIcon from "../icon/whisperkit-argmax-black@120.png";
const project = siteConfig.openSource;
const accent = siteConfig.accentColor;
---

<section id="opensource" class="section-shell">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="section-kicker">OPEN SOURCE</p>
      <h2 class="section-title">开源贡献</h2>
      <div class="section-rule" style={{ backgroundColor: accent }}></div>
    </div>

    <div class="space-y-4 lg:col-span-8">
      <div class="relative overflow-hidden rounded-2xl bg-gray-900 p-6 text-white sm:p-8">
        <div
          class="absolute -right-20 -top-24 size-64 rounded-full"
          style={`background: radial-gradient(circle, ${accent}66 0%, transparent 70%)`}
        ></div>
        <div class="relative z-10 flex flex-col gap-6 sm:flex-row sm:items-start">
          <img src={whisperIcon.src} alt="WhisperKit" class="h-12 w-auto shrink-0 rounded-lg bg-white p-1.5 object-contain" />
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-blue-300">FRAMEWORK IMPACT</p>
            <h3 class="mt-3 text-2xl font-bold sm:text-3xl">WhisperKit</h3>
            <p class="mt-4 text-sm leading-relaxed text-gray-300 sm:text-base">{project.frameworkIntro}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.impactFacts.map((fact) => (
                <span class="rounded-full border border-gray-700 bg-gray-800 px-3 py-1.5 text-xs font-semibold text-gray-200">{fact}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <article class="rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-xl sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <div class="flex items-center gap-4">
            <img src={whisperIcon.src} alt="WhisperKit" class="h-10 w-auto object-contain" />
            <div>
              <h3 class="text-xl font-bold text-gray-900 sm:text-2xl">{project.name}</h3>
              <p class="mt-1 text-sm text-gray-500">{project.tagline}</p>
            </div>
          </div>
          <a href={project.prLink} target="_blank" rel="noopener noreferrer" class="rounded-full px-4 py-2 text-xs font-bold text-white" style={{ backgroundColor: accent }}>PR #511 · 已合入 ↗</a>
        </div>

        <div class="mt-7 grid gap-4 sm:grid-cols-[auto_1fr_auto_1fr_auto] sm:items-center">
          <span class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-center text-xs font-bold text-gray-700">AirTrim 产品问题</span>
          <span class="hidden h-px bg-gray-300 sm:block"></span>
          <span class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-center text-xs font-bold text-gray-700">协议边界定位</span>
          <span class="hidden h-px bg-gray-300 sm:block"></span>
          <span class="rounded-lg bg-gray-900 px-3 py-2 text-center text-xs font-bold text-white">上游合入</span>
        </div>

        <p class="mt-7 text-sm leading-relaxed text-gray-600 sm:text-base">{project.description}</p>
        <p class="mt-5 border-l-2 pl-4 text-sm font-semibold leading-relaxed text-gray-800" style={{ borderColor: accent }}>{project.proof}</p>

        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          <a href={project.airTrimLink} target="_blank" rel="noopener noreferrer" class="text-blue-700 underline underline-offset-4">AirTrim ↗</a>
          <a href={project.prLink} target="_blank" rel="noopener noreferrer" class="text-blue-700 underline underline-offset-4">查看 PR #511 ↗</a>
          <a href={project.repoLink} target="_blank" rel="noopener noreferrer" class="text-gray-700 underline underline-offset-4">WhisperKit 源仓库 ↗</a>
        </div>
      </article>
    </div>
  </div>
</section>
